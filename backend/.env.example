# Environment Variables untuk Backend S-Triage

# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production
JWT_EXPIRES_IN=8h

# Database Configuration (PostgreSQL)
# Option 1: Gunakan DATABASE_URL untuk Supabase atau hosted PostgreSQL
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# Option 2: Gunakan konfigurasi individual (jika tidak pakai DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=s_triage_db
DB_USER=postgres
DB_PASSWORD=postgres
