# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=1d

# Database Configuration (PostgreSQL / Supabase)
# Opsi 1: Menggunakan Sequelize via Direct PostgreSQL Connection URI dari Supabase
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Opsi 2 (Opsional): Menggunakan Supabase SDK (@supabase/supabase-js) untuk Storage/Realtime
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
